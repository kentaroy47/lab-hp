---
import { Image } from "astro:assets";
import { t, otherLocale, type Locale } from "../i18n/strings";
import { site } from "../data/site";
import logo from "../assets/csg.png";

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const s = t(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (p: string) => `${base}/${locale}${p}`;
const other = otherLocale(locale);
const altHref = `${base}/${other}${path}`;

const links = [
  { label: s.nav.research, to: "/research" },
  { label: s.nav.projects, to: "/projects" },
  { label: s.nav.papers, to: "/papers" },
  { label: s.nav.members, to: "/members" },
  { label: s.nav.recruit, to: "/recruit" },
];
---

<header class="sticky top-0 z-50 border-b border-navy-900/8 bg-paper-100/85 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5">
    <a href={href("")} class="flex shrink-0 items-center gap-2.5">
      <Image src={logo} alt="" widths={[40, 80]} sizes="40px" class="h-10 w-auto" loading="eager" />
      <span class="hidden text-sm font-bold tracking-tight text-navy-900 sm:block">
        Keio <span class="text-coral-500">CSG</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <a
          href={href(l.to)}
          class:list={[
            "rounded-lg px-3 py-2 text-sm font-medium text-navy-700 transition-colors hover:bg-paper-300/60 hover:text-navy-900",
            path.startsWith(l.to) && "bg-paper-300/70 text-navy-900",
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={altHref}
        class="rounded-lg border border-navy-900/12 px-2.5 py-1.5 text-xs font-semibold text-navy-700 transition-colors hover:border-coral-400 hover:text-coral-600"
      >
        {s.common.langSwitch}
      </a>
      <button
        id="contact-open"
        type="button"
        class="hidden rounded-lg bg-coral-500 px-3.5 py-2 text-xs font-bold text-white transition-colors hover:bg-coral-600 sm:block"
      >
        Contact
      </button>
      <button
        id="nav-toggle"
        aria-label="Menu"
        class="grid h-9 w-9 place-items-center rounded-lg border border-navy-900/12 text-navy-700 md:hidden"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M2 4h12M2 8h12M2 12h12" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-navy-900/8 bg-paper-50 px-5 py-3 md:hidden">
    {links.map((l) => (
      <a href={href(l.to)} class="block rounded-lg px-3 py-2.5 text-sm font-medium text-navy-700 hover:bg-paper-200">
        {l.label}
      </a>
    ))}
  </nav>
</header>

<!-- Contact details in place, rather than firing the visitor's mail client -->
<dialog
  id="contact-dialog"
  class="w-[min(30rem,calc(100vw-2rem))] rounded-3xl border border-navy-900/10 bg-paper-50 p-0 text-navy-800 backdrop:bg-navy-900/40 backdrop:backdrop-blur-sm"
>
  <div class="p-8">
    <div class="flex items-start justify-between gap-4">
      <h2 class="text-xl font-bold tracking-tight text-navy-900">
        {locale === "ja" ? "連絡先" : "Contact"}
      </h2>
      <button id="contact-close" type="button" aria-label="Close" class="-mr-1 -mt-1 rounded-lg p-1.5 text-navy-500 hover:bg-paper-200 hover:text-navy-900">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M5 5l10 10M15 5L5 15" />
        </svg>
      </button>
    </div>

    <p class="mt-4 text-sm leading-relaxed text-navy-600">
      {locale === "ja"
        ? "研究室見学、大学院進学、共同研究のご相談など、お気軽にご連絡ください。"
        : "Lab visits, graduate study, research collaboration — feel free to get in touch."}
    </p>

    <div class="mt-6 rounded-2xl bg-paper-200/70 p-5">
      <p class="text-xs font-bold uppercase tracking-widest text-navy-500">Email</p>
      <div class="mt-2 flex flex-wrap items-center gap-3">
        <code id="contact-email" class="font-mono text-base font-bold text-navy-900">{site.email}</code>
        <button
          id="contact-copy"
          type="button"
          class="rounded-lg bg-navy-800 px-3 py-1.5 text-xs font-bold text-paper-50 transition-colors hover:bg-navy-700"
        >
          {locale === "ja" ? "コピー" : "Copy"}
        </button>
      </div>
      <p class="mt-2 text-xs text-navy-500">{site.pi}</p>
    </div>

    <div class="mt-5 space-y-1 text-sm text-navy-600">
      <p class="text-xs font-bold uppercase tracking-widest text-navy-500">
        {locale === "ja" ? "所在地" : "Address"}
      </p>
      <p class="pt-1">{site.address.postal}</p>
      <p>{locale === "ja" ? site.address.ja : site.address.en}</p>
      <p class="pt-1 text-navy-500">
        {locale === "ja" ? "学生居室" : "Students"}: {site.rooms.students} ／ PI: {site.rooms.pi}
      </p>
    </div>

    <div class="mt-6 flex flex-wrap gap-2.5">
      <a
        href={`mailto:${site.email}`}
        class="rounded-xl bg-coral-500 px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-coral-600"
      >
        {locale === "ja" ? "メールを書く" : "Write an email"}
      </a>
      <a
        href={site.mapUrl}
        target="_blank"
        rel="noopener"
        class="rounded-xl border-2 border-navy-800 px-4 py-2.5 text-sm font-bold text-navy-800 transition-colors hover:bg-navy-800 hover:text-paper-50"
      >
        {locale === "ja" ? "アクセス" : "Access"}
      </a>
    </div>
  </div>
</dialog>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => menu?.classList.toggle("hidden"));

  const dialog = document.getElementById("contact-dialog") as HTMLDialogElement | null;
  document.getElementById("contact-open")?.addEventListener("click", () => dialog?.showModal());
  document.getElementById("contact-close")?.addEventListener("click", () => dialog?.close());

  // Clicking the backdrop closes it; clicks inside the panel must not.
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });

  const copyButton = document.getElementById("contact-copy");
  copyButton?.addEventListener("click", async () => {
    const email = document.getElementById("contact-email")?.textContent?.trim();
    if (!email) return;
    try {
      await navigator.clipboard.writeText(email);
      const original = copyButton.textContent;
      copyButton.textContent = "✓";
      setTimeout(() => (copyButton.textContent = original), 1400);
    } catch {
      // Clipboard can be blocked; the address stays selectable on screen either way.
    }
  });
</script>
