---
import { Image } from "astro:assets";
import { t, otherLocale, type Locale } from "../i18n/strings";
import { site } from "../data/site";
import logo from "../assets/csg.png";

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const s = t(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (p: string) => `${base}/${locale}${p}`;
const other = otherLocale(locale);
const altHref = `${base}/${other}${path}`;

const links = [
  { label: s.nav.research, to: "/research" },
  { label: s.nav.projects, to: "/projects" },
  { label: s.nav.papers, to: "/papers" },
  { label: s.nav.members, to: "/members" },
  { label: s.nav.recruit, to: "/recruit" },
];
---

<header class="sticky top-0 z-50 border-b border-navy-900/8 bg-paper-100/85 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5">
    <a href={href("")} class="flex shrink-0 items-center gap-2.5">
      <Image src={logo} alt="" widths={[40, 80]} sizes="40px" class="h-10 w-auto" loading="eager" />
      <span class="hidden text-sm font-bold tracking-tight text-navy-900 sm:block">
        Keio <span class="text-coral-500">CSG</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <a
          href={href(l.to)}
          class:list={[
            "rounded-lg px-3 py-2 text-sm font-medium text-navy-700 transition-colors hover:bg-paper-300/60 hover:text-navy-900",
            path.startsWith(l.to) && "bg-paper-300/70 text-navy-900",
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={altHref}
        class="rounded-lg border border-navy-900/12 px-2.5 py-1.5 text-xs font-semibold text-navy-700 transition-colors hover:border-coral-400 hover:text-coral-600"
      >
        {s.common.langSwitch}
      </a>
      <a
        href={`mailto:${site.email}`}
        class="hidden rounded-lg bg-coral-500 px-3.5 py-2 text-xs font-bold text-white transition-colors hover:bg-coral-600 sm:block"
      >
        Contact
      </a>
      <button
        id="nav-toggle"
        aria-label="Menu"
        class="grid h-9 w-9 place-items-center rounded-lg border border-navy-900/12 text-navy-700 md:hidden"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M2 4h12M2 8h12M2 12h12" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-navy-900/8 bg-paper-50 px-5 py-3 md:hidden">
    {links.map((l) => (
      <a href={href(l.to)} class="block rounded-lg px-3 py-2.5 text-sm font-medium text-navy-700 hover:bg-paper-200">
        {l.label}
      </a>
    ))}
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>
