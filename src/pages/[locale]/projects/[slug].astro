---
import Layout from "../../../layouts/Layout.astro";
import Icon from "../../../components/Icon.astro";
import { projects } from "../../../data/projects";
import { locales, t, type Locale } from "../../../i18n/strings";

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    projects.map((project) => ({ params: { locale, slug: project.slug }, props: { project } })),
  );
}

const locale = Astro.params.locale as Locale;
const { project } = Astro.props;
const s = t(locale);
const ja = locale === "ja";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const tagStyles: Record<string, string> = {
  security: "bg-coral-300/30 text-coral-600",
  sensing: "bg-sky-200/70 text-navy-700",
  computing: "bg-sand-300/50 text-navy-700",
};
---

<Layout
  locale={locale}
  path={`/projects/${project.slug}`}
  title={project.title}
  description={ja ? project.summary.ja : project.summary.en}
>
  <section class="relative overflow-hidden border-b border-navy-900/8 bg-gradient-to-b from-sky-200/45 to-paper-100">
    <div class="trace-grid absolute inset-0 opacity-70"></div>
    <div class="relative mx-auto max-w-4xl px-5 py-16 md:py-20">
      <a href={`${base}/${locale}/projects`} class="text-sm font-bold text-coral-600 hover:underline">
        ← {s.common.backToProjects}
      </a>

      <div class="mt-7 flex flex-wrap items-center gap-2">
        <span class:list={["rounded-full px-3 py-1 text-xs font-bold", tagStyles[project.tag]]}>{project.tag}</span>
        {project.venue && <span class="font-mono text-xs font-medium text-navy-600">{project.venue}</span>}
      </div>

      <h1 class="mt-5 text-4xl font-bold tracking-tight text-navy-900">{project.title}</h1>
      {project.subtitle && <p class="mt-4 text-lg leading-snug text-navy-600">{project.subtitle}</p>}

      {project.links && (
        <div class="mt-8 flex flex-wrap gap-3">
          {project.links.map((l) => (
            <a
              href={l.href}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-xl bg-navy-800 px-4 py-2.5 text-sm font-bold text-paper-50 transition-colors hover:bg-navy-700"
            >
              {l.label}
              <Icon name="external" class="h-3.5 w-3.5" />
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <article class="mx-auto max-w-4xl px-5 py-16 md:py-20">
    <p class="text-lg leading-relaxed text-navy-700">{ja ? project.summary.ja : project.summary.en}</p>

    {project.sections?.map((sec) => (
      <section class="mt-12">
        <h2 class="text-xl font-bold tracking-tight text-navy-900">{sec.heading}</h2>
        <p class="mt-4 leading-relaxed text-navy-600">{sec.body}</p>
      </section>
    ))}
  </article>
</Layout>
