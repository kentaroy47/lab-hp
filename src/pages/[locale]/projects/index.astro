---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import Icon from "../../../components/Icon.astro";
import { categoryOf, categoryLabels, type ProjectCategory } from "../../../data/projectCategories";
import { locales, t, type Locale } from "../../../i18n/strings";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const s = t(locale);
const ja = locale === "ja";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const all = await getCollection("projects");
// Newest first; `order` pins the flagship projects to the top of their year.
const projects = all.sort((a, b) => {
  if (b.data.year !== a.data.year) return b.data.year - a.data.year;
  return (a.data.order ?? 99) - (b.data.order ?? 99);
});

/** Four choices instead of fourteen: a highlights view plus the three research themes. */
const filters = [
  { key: "all", label: { ja: "すべて", en: "All" }, count: projects.length },
  {
    key: "highlight",
    label: { ja: "注目", en: "Highlights" },
    count: projects.filter((p) => p.data.highlight).length,
  },
  ...(["computing", "security", "sensing"] as ProjectCategory[]).map((c) => ({
    key: `category:${c}`,
    label: categoryLabels[c],
    count: projects.filter((p) => categoryOf(p) === c).length,
  })),
];

const statusLabels: Record<string, { ja: string; en: string; cls: string }> = {
  published: { ja: "発表済み", en: "Published", cls: "bg-paper-300/70 text-navy-700" },
  accepted: { ja: "採択", en: "Accepted", cls: "bg-coral-300/30 text-coral-600" },
  preprint: { ja: "プレプリント", en: "Preprint", cls: "bg-sky-200/70 text-navy-700" },
};

const description = ja
  ? `CSGの研究プロジェクト${projects.length}件。CVPR・ICCV・NDSS・ISSCC・IROS・ICRAなどで発表した、インメモリAI回路とLiDARセキュリティの研究成果。`
  : `${projects.length} research projects from CSG, published at CVPR, ICCV, NDSS, ISSCC, IROS, and ICRA — spanning in-memory AI circuits and LiDAR security.`;
---

<Layout locale={locale} path="/projects" title={ja ? "プロジェクト" : "Projects"} description={description}>
  <PageHero
    eyebrow="Projects"
    title={ja ? "研究プロジェクト" : "Projects"}
    lead={ja
      ? `進行中・発表済みの研究プロジェクト${projects.length}件です。論文・コード・プロジェクトページへのリンクを揃えています。`
      : `${projects.length} ongoing and published research projects, with links to papers, code, and project pages.`}
  />

  <!-- Filters -->
  <section class="sticky top-16 z-40 border-b border-navy-900/8 bg-paper-100/90 backdrop-blur-xl">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-2 px-5 py-4">
      {filters.map((f, i) => (
        <button
          type="button"
          data-filter={f.key}
          class:list={[
            "filter-btn inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-bold transition-colors",
            i === 0 ? "bg-navy-800 text-paper-50" : "bg-paper-300/60 text-navy-700 hover:bg-paper-300",
          ]}
        >
          {ja ? f.label.ja : f.label.en}
          <span class="font-mono text-[11px] font-medium opacity-60">{f.count}</span>
        </button>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 md:py-20">
    <div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <a
          href={`${base}/${locale}/projects/${p.id}`}
          class="project-card paper-card paper-card-hover group flex flex-col overflow-hidden rounded-3xl border border-navy-900/8 bg-paper-50 transition-all duration-300 hover:-translate-y-1"
          data-category={categoryOf(p)}
          data-highlight={p.data.highlight ? "true" : "false"}
        >
          {p.data.teaser && (
            <div class="aspect-16/9 overflow-hidden border-b border-navy-900/8 bg-paper-200/60">
              <img
                src={`${base}/projects/${p.data.teaser}`}
                alt=""
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
          )}

          <div class="flex flex-1 flex-col p-6">
            <div class="flex flex-wrap items-center gap-2">
              <span class="font-mono text-xs font-bold text-coral-600">{p.data.venue} {p.data.year}</span>
              <span class:list={["rounded-full px-2.5 py-0.5 text-[11px] font-bold", statusLabels[p.data.status].cls]}>
                {ja ? statusLabels[p.data.status].ja : statusLabels[p.data.status].en}
              </span>
              {p.data.highlight && (
                <span class="rounded-full bg-sand-300/70 px-2.5 py-0.5 text-[11px] font-bold text-navy-800">★</span>
              )}
            </div>

            <h2 class="mt-3 text-lg font-bold leading-snug tracking-tight text-navy-900 group-hover:text-coral-600">
              {p.data.short_title}
            </h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-navy-600 line-clamp-4">
              {ja ? p.data.description_ja : p.body?.trim().split("\n").join(" ")}
            </p>

            <div class="mt-5 flex flex-wrap gap-1.5">
              {p.data.tags.map((tag) => (
                <span class="rounded-full bg-paper-200 px-2.5 py-0.5 text-[11px] font-medium text-navy-600">{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>

    <p id="empty-state" class="hidden py-16 text-center text-navy-500">
      {ja ? "該当するプロジェクトがありません。" : "No projects match this filter."}
    </p>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".project-card");
  const empty = document.getElementById("empty-state");

  function apply(filter: string) {
    buttons.forEach((b) => {
      const on = b.dataset.filter === filter;
      b.classList.toggle("bg-navy-800", on);
      b.classList.toggle("text-paper-50", on);
      b.classList.toggle("bg-paper-300/60", !on);
      b.classList.toggle("text-navy-700", !on);
    });

    let visible = 0;
    cards.forEach((card) => {
      let show = true;
      if (filter === "highlight") {
        show = card.dataset.highlight === "true";
      } else if (filter.startsWith("category:")) {
        show = card.dataset.category === filter.slice(9);
      }
      card.classList.toggle("hidden", !show);
      if (show) visible++;
    });

    empty?.classList.toggle("hidden", visible > 0);
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter!;
      apply(filter);
      // Keep the filter in the URL so the view can be linked to and shared.
      const url = new URL(window.location.href);
      if (filter === "all") url.searchParams.delete("filter");
      else url.searchParams.set("filter", filter);
      history.replaceState(null, "", url);
    });
  });

  // Honour ?filter= on load, so links from the research page land pre-filtered.
  const requested = new URL(window.location.href).searchParams.get("filter");
  if (requested && [...buttons].some((b) => b.dataset.filter === requested)) apply(requested);
</script>
