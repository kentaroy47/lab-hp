---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const target = `${base}/ja`;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>Keio Computing and Sensing Group</title>
  </head>
  <body>
    <a href={target}>Keio Computing and Sensing Group</a>
  </body>
</html>
